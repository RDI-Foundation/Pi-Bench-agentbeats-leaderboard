{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_codex_base_url": {
        "type": "string",
        "default": "https://api.moonshot.cn/v1"
      },
      "agent_codex_model": {
        "type": "string",
        "default": "kimi-k3"
      },
      "agent_codex_model_provider": {
        "type": "string",
        "default": "moonshot"
      },
      "agent_purple_llm_api_key": {
        "type": "string",
        "secret": true
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_openai_api_key",
      "agent_purple_llm_api_key",
      "agent_codex_model",
      "agent_codex_model_provider",
      "agent_codex_base_url"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "domain": "all"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/Jyoti-Ranjan-Das845/pi-bench/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/tanxiaobing-hl/leaderboard-pibench-agent/refs/heads/main/amber-manifest.json5",
      "config": {
        "codex_base_url": "${config.agent_codex_base_url}",
        "codex_model": "${config.agent_codex_model}",
        "codex_model_provider": "${config.agent_codex_model_provider}",
        "purple_llm_api_key": "${config.agent_purple_llm_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d4567-5114-7310-ad51-487217436b99",
      "agent": "01a09fb4-ec57-7d13-9703-c9958cb483eb"
    }
  }
}