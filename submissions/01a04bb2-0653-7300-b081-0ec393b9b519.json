{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_cinema_agent_identity": {
        "type": "string",
        "default": ""
      },
      "agent_cinema_api_key": {
        "type": "string",
        "secret": true,
        "default": ""
      },
      "agent_cinema_plan_bindings_json": {
        "type": "string",
        "default": ""
      },
      "agent_cinema_plan_id": {
        "type": "string",
        "default": ""
      },
      "agent_cinema_preflight_mode": {
        "type": "string",
        "enum": [
          "off",
          "required"
        ],
        "default": "off"
      },
      "agent_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "agent_openai_model": {
        "type": "string",
        "default": "gpt-5"
      },
      "agent_reasoning_effort": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "default": "medium"
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_openai_api_key",
      "agent_openai_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "domain": "all"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/Jyoti-Ranjan-Das845/pi-bench/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/tdealer01-crypto/DSG-Cinema-Proof-Agent/86e5a4985bbedf14a6b2369dc96399621dec86be/benchmarks/pibench_dsg/amber-manifest.json5",
      "config": {
        "cinema_agent_identity": "${config.agent_cinema_agent_identity}",
        "cinema_api_key": "${config.agent_cinema_api_key}",
        "cinema_plan_bindings_json": "${config.agent_cinema_plan_bindings_json}",
        "cinema_plan_id": "${config.agent_cinema_plan_id}",
        "cinema_preflight_mode": "${config.agent_cinema_preflight_mode}",
        "openai_api_key": "${config.agent_openai_api_key}",
        "openai_model": "${config.agent_openai_model}",
        "reasoning_effort": "${config.agent_reasoning_effort}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d4567-5114-7310-ad51-487217436b99",
      "agent": "01a04bab-fe8a-7772-b339-3a097e63d31b"
    }
  }
}