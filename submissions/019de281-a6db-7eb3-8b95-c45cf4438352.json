{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "ramen_shield_agent_gemini_api_key": {
        "type": "string",
        "secret": true
      },
      "ramen_shield_agent_ramen_api_key": {
        "type": "string",
        "secret": true
      },
      "ramen_shield_agent_ramen_policy_ids": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_openai_api_key",
      "ramen_shield_agent_ramen_api_key",
      "ramen_shield_agent_ramen_policy_ids",
      "ramen_shield_agent_gemini_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "scenario_scope": "all",
          "concurrency": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "ramen_shield_agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/Jyoti-Ranjan-Das845/pi-bench/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "ramen_shield_agent": {
      "manifest": "https://raw.githubusercontent.com/ramen-ai-dev/ramen-pibench-agent/main/amber/amber-manifest-purple.json5",
      "config": {
        "gemini_api_key": "${config.ramen_shield_agent_gemini_api_key}",
        "ramen_api_key": "${config.ramen_shield_agent_ramen_api_key}",
        "ramen_policy_ids": "${config.ramen_shield_agent_ramen_policy_ids}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#ramen_shield_agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    },
    {
      "to": "#ramen_shield_agent.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d4567-5114-7310-ad51-487217436b99",
      "ramen_shield_agent": "019ddcd3-210a-7592-af4d-406fb1ba1229"
    }
  }
}