{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_google_api_key": {
        "type": "string",
        "secret": true,
        "default": ""
      },
      "agent_llm_model": {
        "type": "string",
        "default": ""
      },
      "agent_llm_provider": {
        "type": "string",
        "default": ""
      },
      "agent_llm_reasoning_effort": {
        "type": "string",
        "default": ""
      },
      "agent_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_openai_api_key",
      "agent_openai_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "domain": "all"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/Jyoti-Ranjan-Das845/pi-bench/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/acboudion/purple-agent-agentbeats-playbot-1/refs/heads/main/amber-manifest.json5",
      "config": {
        "google_api_key": "${config.agent_google_api_key}",
        "llm_model": "${config.agent_llm_model}",
        "llm_provider": "${config.agent_llm_provider}",
        "llm_reasoning_effort": "${config.agent_llm_reasoning_effort}",
        "openai_api_key": "${config.agent_openai_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d4567-5114-7310-ad51-487217436b99",
      "agent": "01a06e23-80e8-7db0-a268-b097393459a4"
    }
  }
}